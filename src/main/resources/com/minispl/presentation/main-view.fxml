<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="780.0" prefWidth="1200.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.minispl.presentation.MainController">

    <!-- Top Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header-bar">
            <!-- App Branding -->
            <VBox alignment="CENTER_LEFT">
                <Label text="⚡ DFIR ORCHESTRATOR" styleClass="app-title"/>
                <Label text="Desktop Incident Response &amp; Digital Forensics Playbook Engine | Mini-SPL" styleClass="app-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Status Badges -->
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Label text="● SQLite: Connected (Foreign Keys Enforced)" styleClass="status-badge-connected"/>
                <Label text="👤 Active: Alice Walker (Senior Analyst)" styleClass="user-badge"/>
            </HBox>
        </HBox>
    </top>

    <!-- Left Navigation Sidebar -->
    <left>
        <VBox spacing="10" styleClass="sidebar">
            <Label text="OPERATIONAL CONSOLES" styleClass="detail-label" style="-fx-padding: 0 0 4 8; -fx-text-fill: #64748b;"/>

            <Button fx:id="btnNavIncidents" text="🚨  Incidents &amp; Triage" onAction="#showIncidents" styleClass="nav-button"/>
            <Button fx:id="btnNavEvidence" text="📦  Evidence &amp; Custody" onAction="#showEvidence" styleClass="nav-button"/>
            <Button fx:id="btnNavAssets" text="🖥  Assets &amp; Inventory" onAction="#showAssets" styleClass="nav-button"/>
            <Button fx:id="btnNavPlaybooks" text="📖  IR Playbooks" onAction="#showPlaybooks" styleClass="nav-button"/>
            <Button fx:id="btnNavReports" text="📊  Audit &amp; Analytics" onAction="#showReports" styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Quick Status Snapshot -->
            <VBox spacing="6" styleClass="sidebar-footer">
                <Label text="SOC STATUS SNAPSHOT" styleClass="detail-label" style="-fx-font-size: 10px; -fx-text-fill: #38bdf8;"/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Active Cases:" styleClass="detail-label" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSidebarOpenCases" text="0 Active" styleClass="detail-value" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Forensic Items:" styleClass="detail-label" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSidebarEvidenceCount" text="0 Items" styleClass="detail-value" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Endpoints:" styleClass="detail-label" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSidebarAssetCount" text="0 Hosts" styleClass="detail-value" style="-fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- Dynamic Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

</BorderPane>
