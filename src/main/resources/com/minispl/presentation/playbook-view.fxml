<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.minispl.presentation.PlaybookViewController">

    <VBox>
        <Label text="Standardized Incident Response Playbooks" styleClass="view-title"/>
        <Label text="Enforced sequence order: Triage → Containment → Evidence Collection → Eradication → Post-Mortem" styleClass="view-subtitle"/>
    </VBox>

    <SplitPane dividerPositions="0.28" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <!-- Left: Playbook Selector -->
        <VBox spacing="10" style="-fx-padding: 0 10 0 0;">
            <Label text="AVAILABLE PLAYBOOKS" styleClass="detail-label" style="-fx-text-fill: #38bdf8;"/>
            <ListView fx:id="listPlaybooks" VBox.vgrow="ALWAYS" styleClass="table-view"/>
        </VBox>

        <!-- Right: Step Execution Ledger -->
        <VBox spacing="12" style="-fx-padding: 0 0 0 10;">
            <VBox styleClass="detail-box" spacing="4">
                <Label fx:id="lblPlaybookTitle" text="Select Playbook" styleClass="view-title" style="-fx-font-size: 16px;"/>
                <Label fx:id="lblPlaybookDescription" text="Description" styleClass="detail-value" wrapText="true"/>
            </VBox>

            <Label text="MANDATORY INVESTIGATION &amp; REMEDIATION PHASES" styleClass="detail-label"/>
            <TableView fx:id="tblSteps" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colSeq" text="Seq" prefWidth="50"/>
                    <TableColumn fx:id="colPhase" text="Workflow Phase" prefWidth="150"/>
                    <TableColumn fx:id="colStepName" text="Action / Task Name" prefWidth="220"/>
                    <TableColumn fx:id="colActionType" text="Command Binding" prefWidth="160"/>
                    <TableColumn fx:id="colCriteria" text="Pass / Fail Completion Criteria" prefWidth="280"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>

</VBox>
