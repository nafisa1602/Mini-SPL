<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.minispl.presentation.EvidenceViewController">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Digital Evidence &amp; Chain of Custody (Person B)" styleClass="view-title"/>
            <Label text="Evidence CRUD, SHA-256 Verification &amp; Custody State Machine (Seized → In Analysis → Court Hold → Archived)" styleClass="view-subtitle"/>
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button text="＋ Catalog Evidence" onAction="#handleCreateEvidence" styleClass="btn-primary"/>
            <Label fx:id="lblTotalArtifacts" text="Total Preserved Artifacts: 0" styleClass="status-badge-connected"/>
            <Button text="⟳ Refresh" onAction="#refresh" styleClass="btn-secondary"/>
        </HBox>
    </HBox>

    <!-- Table of Evidence Items -->
    <TableView fx:id="tblEvidence" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colIncident" text="Case #" prefWidth="65"/>
            <TableColumn fx:id="colName" text="Evidence Name" prefWidth="240"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="130"/>
            <TableColumn fx:id="colHash" text="Cryptographic Hash (SHA-256)" prefWidth="180"/>
            <TableColumn fx:id="colStatus" text="Custody State" prefWidth="125"/>
            <TableColumn fx:id="colSourceAsset" text="Source Asset" prefWidth="140"/>
            <TableColumn fx:id="colCustodian" text="Current Custodian" prefWidth="140"/>
            <TableColumn fx:id="colCollectedAt" text="Seized At" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Detailed Overview & Custody State Machine Action Bar -->
    <VBox styleClass="detail-box" spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="CHAIN OF CUSTODY VERIFICATION:" styleClass="detail-label" style="-fx-text-fill: #34d399;"/>
            <Label fx:id="lblEvidenceName" text="Select artifact..." styleClass="detail-value" style="-fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCustodyMessage" text="" style="-fx-text-fill: #38bdf8; -fx-font-size: 11px; -fx-font-style: italic;"/>
        </HBox>
        <Separator style="-fx-background-color: #334155;"/>
        <VBox spacing="6">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="FULL SHA-256 HASH:" styleClass="detail-label" prefWidth="140"/>
                <Label fx:id="lblFullHash" text="-" styleClass="detail-value" style="-fx-font-family: monospace; -fx-text-fill: #38bdf8;"/>
            </HBox>
            <HBox spacing="30">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="CURRENT STATE:" styleClass="detail-label"/>
                    <Label fx:id="lblCustodyStatus" text="-" styleClass="detail-value" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="CURRENT CUSTODIAN:" styleClass="detail-label"/>
                    <Label fx:id="lblCustodianName" text="-" styleClass="detail-value"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="SOURCE HOST:" styleClass="detail-label"/>
                    <Label fx:id="lblSourceHost" text="-" styleClass="detail-value"/>
                </HBox>
            </HBox>
        </VBox>

        <Separator style="-fx-background-color: #334155;"/>

        <!-- Custody State Machine Transitions (strictly shows valid transitions only!) -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <HBox fx:id="custodyControlsBox" alignment="CENTER_LEFT" spacing="8">
                <Label text="Custody State Machine:" styleClass="detail-label" style="-fx-text-fill: #a855f7;"/>
                <Button fx:id="btnBeginAnalysis" text="🔬 Begin Analysis →" onAction="#handleBeginAnalysis" styleClass="btn-primary"/>
                <Button fx:id="btnPlaceCourtHold" text="⚖ Place on Court Hold" onAction="#handlePlaceCourtHold" styleClass="btn-warning"/>
                <Button fx:id="btnReleaseCourtHold" text="🔬 Release to Analysis" onAction="#handleReleaseCourtHold" styleClass="btn-success"/>
                <Button fx:id="btnArchiveArtifact" text="🗄 Archive Artifact" onAction="#handleArchiveArtifact" styleClass="btn-secondary"/>
                <Label fx:id="lblArchivedNotice" text="✔ Vault Archived (Permanently Locked)" style="-fx-text-fill: #34d399; -fx-font-weight: bold;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Delete Evidence Item -->
            <Button fx:id="btnDeleteEvidence" text="🗑 Delete Artifact" onAction="#handleDeleteEvidence" styleClass="btn-danger"/>
        </HBox>
    </VBox>

</VBox>
